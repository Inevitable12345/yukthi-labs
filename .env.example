# ---------------------------------------------------------------------------
# Yukthi Lab — environment
# Copy to `.env.local` for development. No secret is ever read on the client;
# only NEXT_PUBLIC_* values are exposed to the browser.
# ---------------------------------------------------------------------------

# Canonical origin, used for metadata, Open Graph, sitemap and robots.
# Leave unset locally; Vercel injects a usable default (see docs/DEPLOYMENT.md).
NEXT_PUBLIC_SITE_URL=https://yukthi.example

# Where the contact form delivers. Unset => submissions are validated,
# rate-limited and logged server-side only (safe default, nothing leaves the box).
CONTACT_WEBHOOK_URL=

# Address shown on /contact. Falls back to a neutral placeholder when unset.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional privacy-respecting analytics (cookieless). Unset => no analytics at all.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
