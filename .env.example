# ============================================================================
# YUKTHI LAB — ENVIRONMENT
# ----------------------------------------------------------------------------
# Copy to `.env.local` for development. Every variable here is optional: the
# application builds and runs with none of them set.
#
# There are no secrets in this file and there is no variable that belongs in the
# client bundle beyond the site URL. If you find yourself adding an API key with
# a NEXT_PUBLIC_ prefix, it will be readable by every visitor.
# ============================================================================

# The canonical origin, used for canonical URLs, Open Graph tags, the sitemap
# and robots.txt. No trailing slash.
#
# Unset or blank falls back to http://localhost:3000 — a blank value is treated
# as unset rather than as an error, because a blank environment variable is a
# common deployment mistake and should not fail the build.
NEXT_PUBLIC_SITE_URL=https://yukthi.example

# Set automatically on Vercel; used as a fallback when NEXT_PUBLIC_SITE_URL is
# not configured. Do not set this by hand.
# NEXT_PUBLIC_VERCEL_URL=
