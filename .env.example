# ============================================================================
# YUKTHI LAB — ENVIRONMENT
# ----------------------------------------------------------------------------
# Copy to .env.local and fill in what you need. Every variable here is optional
# except NEXT_PUBLIC_SITE_URL, and the site runs correctly with none of them set.
#
# Never commit a filled-in copy of this file.
# ============================================================================

# Canonical origin. Used for absolute URLs in metadata, Open Graph, robots and
# the sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ----------------------------------------------------------------------------
# ANALYTICS (optional)
# ----------------------------------------------------------------------------
# Leave the provider empty and no analytics script is ever requested, regardless
# of consent. When a provider is set, the script still loads only after the
# reader grants the "analytics" category.
#
# Setting a provider also widens the Content-Security-Policy to that provider's
# origins — see lib/security/headers.ts. Nothing else needs changing.
#
# One of: plausible | posthog | ga4 | (empty)
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# posthog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ga4
NEXT_PUBLIC_GA_ID=


# ----------------------------------------------------------------------------
# CONTACT (optional)
# ----------------------------------------------------------------------------
# With no provider set, a collaboration enquiry is written to the server log and
# the sender is told plainly that it was not delivered — a misconfigured
# deployment never shows a success message for a message that went nowhere.
#
# One of: resend | log | (empty, same as log)
CONTACT_PROVIDER=

# Required when CONTACT_PROVIDER=resend. These are server-only: they must NOT be
# prefixed with NEXT_PUBLIC_, or they would be inlined into the client bundle.
CONTACT_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
